# Copier vers .env.local en développement ou configurer dans l'hébergeur.
# Ne jamais committer de vraies valeurs.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de données PostgreSQL (pas encore connectée)
DATABASE_URL=

# Messagerie transactionnelle pour les futures vérifications e-mail
MAIL_API_KEY=
MAIL_FROM_EMAIL=

# Compte administrateur initial (hash via node scripts/hash-admin-password.mjs)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Secret aléatoire de 32 caractères minimum, uniquement côté serveur
ADMIN_SESSION_SECRET=

# OpenAI Responses API + recherche Web pour ATLAS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# GitHub App dédiée à NOVEXA
# Permissions minimales : Contents RW, Pull requests RW
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=a95143b-a17y
GITHUB_REPO=novexa_v1
GITHUB_BASE_BRANCH=main

# Veille périodique Vercel (Bearer token des appels Cron)
CRON_SECRET=

# Médias et paiements (intégrations futures, non activées)
HEYGEN_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Veille périodique Vercel (Bearer token des appels Cron)
