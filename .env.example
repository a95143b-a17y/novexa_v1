# Copier vers .env.local en développement ou configurer chez l'hébergeur.
# Ne jamais committer de vraies valeurs.

NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=

# Better Auth — authentification multi-utilisateur
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# E-mail transactionnel via Resend
RESEND_API_KEY=
EMAIL_FROM=NOVEXA <noreply@example.com>

# Paiements Stripe — intégration en mode TEST uniquement
# Créer les produits et prix de test dans Stripe, puis renseigner leurs identifiants.
# Les clés live ne sont pas acceptées par le code actuel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LEVEL_2=
STRIPE_PRICE_LEVEL_3=

# Stockage privé des documents — créer un Blob Store Vercel avec accès Private
BLOB_READ_WRITE_TOKEN=

# OpenAI Responses API + recherche Web pour ATLAS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# GitHub App dédiée à NOVEXA
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=a95143b-a17y
GITHUB_REPO=novexa_v1
GITHUB_BASE_BRANCH=main

# Veille périodique Vercel
CRON_SECRET=

# Médias
HEYGEN_API_KEY=